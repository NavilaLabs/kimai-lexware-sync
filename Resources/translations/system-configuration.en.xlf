<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" target-language="en" datatype="plaintext" original="system-configuration.en.xlf">
        <body>
            <trans-unit id="lexware_sync.license_key" resname="lexware_sync.license_key">
                <source>lexware_sync.license_key</source>
                <target>License key</target>
            </trans-unit>
            <trans-unit id="lexware_sync.license_key_help" resname="lexware_sync.license_key_help">
                <source>lexware_sync.license_key_help</source>
                <target>The license key from your purchase confirmation. This version ships with the license check switched off, so leaving the field empty changes nothing yet. Once the check is switched on, an installation without a confirmed license converts no order confirmation into a project and writes no invoice back to Lexware.</target>
            </trans-unit>
            <trans-unit id="lexware_sync.api_key" resname="lexware_sync.api_key">
                <source>lexware_sync.api_key</source>
                <target>Lexware Public API key, left empty keeps the currently stored key</target>
            </trans-unit>
            <trans-unit id="lexware_sync.public_base_url" resname="lexware_sync.public_base_url">
                <source>lexware_sync.public_base_url</source>
                <target>Public base URL Lexware should call, for example a tunnel URL in local development, empty uses this instance's own configured URL</target>
            </trans-unit>
            <trans-unit id="lexware_sync.auto_convert_enabled" resname="lexware_sync.auto_convert_enabled">
                <source>lexware_sync.auto_convert_enabled</source>
                <target>Automatically convert a matching order confirmation into a project</target>
            </trans-unit>
            <trans-unit id="lexware_sync.title_regex" resname="lexware_sync.title_regex">
                <source>lexware_sync.title_regex</source>
                <target>Title pattern an order confirmation must match to convert automatically, empty matches every title</target>
            </trans-unit>
            <trans-unit id="lexware_sync.read_lines_enabled" resname="lexware_sync.read_lines_enabled">
                <source>lexware_sync.read_lines_enabled</source>
                <target>Create one activity per matching order confirmation line</target>
            </trans-unit>
            <trans-unit id="lexware_sync.line_regex" resname="lexware_sync.line_regex">
                <source>lexware_sync.line_regex</source>
                <target>Pattern a line's name or description must match to produce an activity, empty matches every line</target>
            </trans-unit>
            <trans-unit id="lexware_sync.reconcile_interval_minutes" resname="lexware_sync.reconcile_interval_minutes">
                <source>lexware_sync.reconcile_interval_minutes</source>
                <target>Minutes between reconciliation polls</target>
            </trans-unit>
            <trans-unit id="lexware_sync.invoice_title_regex" resname="lexware_sync.invoice_title_regex">
                <source>lexware_sync.invoice_title_regex</source>
                <target>Title pattern an invoice draft must match to be tracked, empty matches every title</target>
            </trans-unit>
            <trans-unit id="lexware_sync.project_title_source" resname="lexware_sync.project_title_source">
                <source>lexware_sync.project_title_source</source>
                <target>What a converted project is named: the voucher number, the order confirmation's own title, or the customer combined with the title</target>
            </trans-unit>
            <trans-unit id="lexware_sync.project_completion_mode" resname="lexware_sync.project_completion_mode">
                <source>lexware_sync.project_completion_mode</source>
                <target>What marking a project completed does: set an end date, or hide its visibility</target>
            </trans-unit>
            <trans-unit id="lexware_sync.check_api_key_interval_days" resname="lexware_sync.check_api_key_interval_days">
                <source>lexware_sync.check_api_key_interval_days</source>
                <target>Days between scheduled API key health checks, only documents the expected cron cadence, enforces nothing itself</target>
            </trans-unit>
            <trans-unit id="lexware_sync.check_license_interval_days" resname="lexware_sync.check_license_interval_days">
                <source>lexware_sync.check_license_interval_days</source>
                <target>Days between scheduled license health checks, only documents the expected cron cadence, enforces nothing itself</target>
            </trans-unit>
        </body>
    </file>
</xliff>
