{% extends 'base.html.twig' %}

{% set statusFilters = {
    'open': 'lexware_sync.filter.open',
    'converted': 'lexware_sync.filter.converted',
    'rejected': 'lexware_sync.filter.rejected',
    'all': 'lexware_sync.filter.all'
} %}

{% set listStateFields %}
    {% for name, value in listRouteParameters %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endfor %}
    <input type="hidden" name="page" value="{{ orderConfirmations.currentPage }}">
{% endset %}

{% block main %}
    {{ include('@KimaiLexwareSync/license/banner.html.twig') }}

    {% embed '@theme/embeds/card.html.twig' %}
        {% block box_title %}{{ 'lexware_sync.triage.title'|trans }}{% endblock %}
        {% block box_tools %}
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <form method="get" action="{{ path('lexware_sync_triage') }}" class="input-group input-group-sm w-auto">
                    <input type="hidden" name="status" value="{{ filter }}">
                    <input type="search" name="search" value="{{ searchTerm }}" class="form-control form-control-sm" placeholder="{{ 'lexware_sync.search_placeholder'|trans }}" aria-label="{{ 'search'|trans }}">
                    <button type="submit" class="btn btn-sm" title="{{ 'search'|trans }}">{{ icon('search') }}</button>
                </form>
                <div class="btn-group btn-group-sm">
                    {% for value, label in statusFilters %}
                        <a href="{{ path('lexware_sync_triage', listRouteParameters|merge({status: value})) }}" class="btn {{ filter == value ? 'btn-primary' : 'btn-outline-secondary' }}">
                            {{ label|trans }} ({{ counts[value] }})
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endblock %}
        {% block box_body %}
            <table class="table table-vcenter">
                <thead>
                    <tr>
                        <th>{{ 'lexware_sync.triage.voucher_number'|trans }}</th>
                        <th>{{ 'lexware_sync.customer'|trans }}</th>
                        <th>{{ 'lexware_sync.triage.voucher_date'|trans }}</th>
                        <th class="text-end">{{ 'lexware_sync.net_total'|trans }}</th>
                        <th class="text-end">{{ 'lexware_sync.line_items'|trans }}</th>
                        <th>{{ 'lexware_sync.status'|trans }}</th>
                        <th>{{ 'lexware_sync.processed'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for orderConfirmation in orderConfirmations %}
                        {% set summary = summaries[orderConfirmation.id] %}
                        <tr>
                            <td>{{ orderConfirmation.voucherNumber }}</td>
                            <td>{{ orderConfirmation.contactName }}</td>
                            <td>{{ orderConfirmation.voucherDate|date_short }}</td>
                            <td class="text-end">{{ summary.totalNetAmount|money(summary.currency) }}</td>
                            <td class="text-end">{{ summary.lineItemCount }}</td>
                            <td>
                                {{ ('lexware_sync.status.' ~ orderConfirmation.status.value)|trans }}
                                {% if orderConfirmation.changedAfterConversion %}
                                    <i class="fas fa-exclamation-triangle text-warning ms-1" title="{{ 'lexware_sync.triage.changed_after_conversion'|trans }}"></i>
                                {% endif %}
                            </td>
                            <td>
                                {% if orderConfirmation.processedAt is not null %}
                                    {{ orderConfirmation.processedAt|date_short }}
                                    {% if orderConfirmation.processedBy is not null %}
                                        &middot; {{ orderConfirmation.processedBy.displayName }}
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                {% if orderConfirmation.status.isConvertible %}
                                    <form method="post" action="{{ path('lexware_sync_triage_convert', {id: orderConfirmation.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('lexware_sync_triage') }}">
                                        {{ listStateFields }}
                                        <button type="submit" class="btn btn-sm btn-primary" {% if licenseState != 'licensed' %}disabled{% endif %}>
                                            {{ (orderConfirmation.status.isRejected ? 'lexware_sync.triage.convert_anyway' : 'lexware_sync.triage.convert')|trans }}
                                        </button>
                                    </form>
                                {% endif %}
                                {% if orderConfirmation.status.isPending %}
                                    <form method="post" action="{{ path('lexware_sync_triage_reject', {id: orderConfirmation.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('lexware_sync_triage') }}">
                                        {{ listStateFields }}
                                        <button type="submit" class="btn btn-sm btn-secondary">{{ 'lexware_sync.triage.reject'|trans }}</button>
                                    </form>
                                {% endif %}
                                {% if orderConfirmation.project is not null %}
                                    <a href="{{ path('project_details', {id: orderConfirmation.project.id}) }}" class="btn btn-sm btn-outline-secondary">{{ 'lexware_sync.open_project'|trans }}</a>
                                {% endif %}
                                <a href="{{ lexware_order_confirmation_url(orderConfirmation.voucherNumber) }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">{{ 'lexware_sync.open_in_lexware'|trans }}</a>
                                {% if summary.hasDocumentFile %}
                                    <a href="{{ path('lexware_sync_document_order_confirmation_pdf', {id: orderConfirmation.id}) }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">{{ 'lexware_sync.open_pdf'|trans }}</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-muted">{{ (searchTerm is not null ? 'lexware_sync.no_search_results' : 'lexware_sync.no_documents')|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block box_footer %}
            {% if orderConfirmations.getNbResults() > 0 %}
                <div class="d-flex align-items-center">
                    <p class="d-none d-sm-block m-0 text-body-secondary">
                        {{ 'pagination'|trans({'%start%': orderConfirmations.getCurrentPageOffsetStart(), '%end%': orderConfirmations.getCurrentPageOffsetEnd(), '%total%': orderConfirmations.getNbResults()}) }}
                    </p>
                    {% if orderConfirmations.haveToPaginate() %}
                        {{ pagination(orderConfirmations, {routeName: 'lexware_sync_triage', routeParams: listRouteParameters, css_container_class: 'pagination m-0 ms-auto d-print-none'}) }}
                    {% endif %}
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
