{% extends 'base.html.twig' %}

{% set statusFilters = {
    'open': 'lexware_sync.filter.open',
    'converted': 'lexware_sync.filter.converted',
    'rejected': 'lexware_sync.filter.rejected',
    'all': 'lexware_sync.filter.all'
} %}

{% set listStateFields %}
    {% for name, value in listRouteParameters %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endfor %}
    <input type="hidden" name="page" value="{{ trackedInvoices.currentPage }}">
{% endset %}

{% block main %}
    {% if licenseVerdict.state != 'licensed' %}
        <div class="alert alert-warning" data-license-state="{{ licenseVerdict.state }}">
            {{ ('lexware_sync.license.' ~ licenseVerdict.state)|trans }}
            {% if licenseVerdict.reason %}
                {{ ('lexware_sync.license.reason.' ~ licenseVerdict.reason)|trans }}
            {% endif %}
        </div>
    {% endif %}

    {% if convertedVoucherNumber %}
        <div class="alert alert-success">
            {{ 'lexware_sync.invoice.converted'|trans }}
            <a href="{{ convertedVoucherUrl }}" target="_blank" rel="noopener">{{ 'lexware_sync.invoice.delete_original_hint'|trans }}</a>
        </div>
    {% endif %}

    {% embed '@theme/embeds/card.html.twig' %}
        {% block box_title %}{{ 'lexware_sync.invoice.title'|trans }}{% endblock %}
        {% block box_tools %}
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <form method="get" action="{{ path('lexware_sync_invoices') }}" class="input-group input-group-sm w-auto">
                    <input type="hidden" name="status" value="{{ filter }}">
                    <input type="search" name="search" value="{{ searchTerm }}" class="form-control form-control-sm" placeholder="{{ 'lexware_sync.search_placeholder'|trans }}" aria-label="{{ 'search'|trans }}">
                    <button type="submit" class="btn btn-sm" title="{{ 'search'|trans }}">{{ icon('search') }}</button>
                </form>
                <div class="btn-group btn-group-sm">
                    {% for value, label in statusFilters %}
                        <a href="{{ path('lexware_sync_invoices', listRouteParameters|merge({status: value})) }}" class="btn {{ filter == value ? 'btn-primary' : 'btn-outline-secondary' }}">
                            {{ label|trans }} ({{ counts[value] }})
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endblock %}
        {% block box_body %}
            <table class="table table-vcenter">
                <thead>
                    <tr>
                        <th>{{ 'lexware_sync.invoice.voucher_number'|trans }}</th>
                        <th>{{ 'lexware_sync.customer'|trans }}</th>
                        <th>{{ 'lexware_sync.invoice.voucher_date'|trans }}</th>
                        <th class="text-end">{{ 'lexware_sync.net_total'|trans }}</th>
                        <th>{{ 'lexware_sync.invoice.project'|trans }}</th>
                        <th>{{ 'lexware_sync.status'|trans }}</th>
                        <th>{{ 'lexware_sync.processed'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for trackedInvoice in trackedInvoices %}
                        {% set summary = summaries[trackedInvoice.id] %}
                        {% set project = trackedInvoice.relatedOrderConfirmation.project %}
                        <tr>
                            <td>{{ trackedInvoice.voucherNumber }}</td>
                            <td>{{ trackedInvoice.contactName }}</td>
                            <td>{{ trackedInvoice.voucherDate|date_short }}</td>
                            <td class="text-end">{{ summary.totalNetAmount|money(summary.currency) }}</td>
                            <td>
                                {% if project is not null %}
                                    <a href="{{ path('project_details', {id: project.id}) }}">{{ project.name }}</a>
                                {% endif %}
                            </td>
                            <td>
                                {{ ('lexware_sync.status.' ~ trackedInvoice.status.value)|trans }}
                                {% if warnings[trackedInvoice.id] %}
                                    <i class="fas fa-exclamation-triangle text-warning ms-1" title="{{ 'lexware_sync.invoice.modified_after_export'|trans }}"></i>
                                {% endif %}
                            </td>
                            <td>
                                {% if trackedInvoice.processedAt is not null %}
                                    {{ trackedInvoice.processedAt|date_short }}
                                    {% if trackedInvoice.processedBy is not null %}
                                        &middot; {{ trackedInvoice.processedBy.displayName }}
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td class="text-end text-nowrap">
                                {% if trackedInvoice.status.isPending %}
                                    <a href="{{ path('lexware_sync_invoices_assign', {id: trackedInvoice.id}) }}" class="btn btn-sm btn-primary">{{ 'lexware_sync.invoice.assign'|trans }}</a>
                                    <form method="post" action="{{ path('lexware_sync_invoices_reject', {id: trackedInvoice.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('lexware_sync_invoices') }}">
                                        {{ listStateFields }}
                                        <button type="submit" class="btn btn-sm btn-secondary">{{ 'lexware_sync.invoice.reject'|trans }}</button>
                                    </form>
                                {% elseif trackedInvoice.status.isRejected %}
                                    <form method="post" action="{{ path('lexware_sync_invoices_reopen', {id: trackedInvoice.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('lexware_sync_invoices') }}">
                                        {{ listStateFields }}
                                        <button type="submit" class="btn btn-sm btn-primary">{{ 'lexware_sync.invoice.assign_anyway'|trans }}</button>
                                    </form>
                                {% elseif trackedInvoice.status.isConverted %}
                                    <a href="{{ path('lexware_sync_document_created_invoice', {id: trackedInvoice.id}) }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">{{ 'lexware_sync.invoice.open_created'|trans }}</a>
                                {% endif %}
                                <a href="{{ lexware_invoice_url(trackedInvoice.voucherNumber) }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">{{ 'lexware_sync.invoice.open_draft'|trans }}</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-muted">{{ (searchTerm is not null ? 'lexware_sync.no_search_results' : 'lexware_sync.no_documents')|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block box_footer %}
            {% if trackedInvoices.getNbResults() > 0 %}
                <div class="d-flex align-items-center">
                    <p class="d-none d-sm-block m-0 text-body-secondary">
                        {{ 'pagination'|trans({'%start%': trackedInvoices.getCurrentPageOffsetStart(), '%end%': trackedInvoices.getCurrentPageOffsetEnd(), '%total%': trackedInvoices.getNbResults()}) }}
                    </p>
                    {% if trackedInvoices.haveToPaginate() %}
                        {{ pagination(trackedInvoices, {routeName: 'lexware_sync_invoices', routeParams: listRouteParameters, css_container_class: 'pagination m-0 ms-auto d-print-none'}) }}
                    {% endif %}
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
